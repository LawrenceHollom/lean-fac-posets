import AharoniKorman.Consolidation.PaperAtomic
import AharoniKorman.Consolidation.GreedySweep

/-! The second consolidation counterexample in `vacillating.tex`. -/

namespace AharoniKorman.Consolidation.ColumnCounterexample

open Set Completion

structure Point where
  column : ℕ
  height : ℕ
  deriving DecidableEq

private theorem Point.eq_of_coordinates {a b : Point}
    (hc : a.column = b.column) (hh : a.height = b.height) : a = b := by
  cases a
  cases b
  simp_all

instance : PartialOrder Point where
  le a b := a.height ≤ b.height ∧ (a.column = b.column ∨ a.column + a.height < b.column)
  le_refl a := ⟨le_rfl, Or.inl rfl⟩
  le_trans a b c hab hbc := by
    refine ⟨hab.1.trans hbc.1, ?_⟩
    rcases hab.2 with hab | hab <;> rcases hbc.2 with hbc | hbc <;> omega
  le_antisymm a b hab hba := by
    have hc : a.column = b.column := by
      rcases hab.2 with h | h <;> rcases hba.2 with h' | h' <;> omega
    exact Point.eq_of_coordinates hc (Nat.le_antisymm hab.1 hba.1)

theorem le_iff {a b : Point} :
    a ≤ b ↔ a.height ≤ b.height ∧ (a.column = b.column ∨ a.column + a.height < b.column) := Iff.rfl

theorem column_mono {a b : Point} (h : a ≤ b) : a.column ≤ b.column := by
  rcases h.2 with hc | hc <;> omega

/-- The order is generated by upward unit steps and the specified horizontal jumps. -/
def Step (a b : Point) : Prop :=
  (a.column = b.column ∧ b.height = a.height + 1) ∨
  (a.height = b.height ∧ a.column + a.height < b.column)

theorem le_iff_steps {a b : Point} : a ≤ b ↔ Relation.ReflTransGen Step a b := by
  have vertical (c j k : ℕ) (hjk : j ≤ k) :
      Relation.ReflTransGen Step ⟨c, j⟩ ⟨c, k⟩ := by
    induction k, hjk using Nat.le_induction with
    | base => exact Relation.ReflTransGen.refl
    | succ k hjk ih => exact ih.tail (Or.inl ⟨rfl, rfl⟩)
  constructor
  · rcases a with ⟨a₁, a₂⟩
    rcases b with ⟨b₁, b₂⟩
    rintro ⟨hab, rfl | hjump⟩
    · exact vertical a₁ a₂ b₂ hab
    · exact (Relation.ReflTransGen.single (show Step ⟨a₁, a₂⟩ ⟨b₁, a₂⟩ from
        Or.inr ⟨rfl, hjump⟩)).trans (vertical b₁ a₂ b₂ hab)
  · intro h
    induction h with
    | refl => exact le_rfl
    | tail hab hbc ih =>
      apply ih.trans
      rcases hbc with ⟨hc, hh⟩ | ⟨hh, hc⟩
      · exact ⟨by omega, Or.inl hc⟩
      · exact ⟨hh.le, Or.inr hc⟩

theorem wellFounded_column_order : WellFounded ((· < ·) : Point → Point → Prop) := by
  apply (measure (fun p : Point => p.column + p.height)).wf.mono
  intro a b hab
  have hc := column_mono hab.le
  have hh := (le_iff.1 hab.le).1
  change a.column + a.height < b.column + b.height
  by_contra! hsum
  exact hab.ne (Point.eq_of_coordinates (by omega) (by omega))

theorem isFAC : IsFAC Point := by
  classical
  intro A hA
  by_cases hne : A.Nonempty
  · let h (b : ℕ) := ∃ a ∈ A, a.height = b
    have hex : ∃ b, h b := by
      obtain ⟨a, ha⟩ := hne
      exact ⟨a.height, a, ha, rfl⟩
    obtain ⟨a, ha, hamin⟩ := Nat.find_spec hex
    have hcols : Point.column '' A ⊆ Iic (a.column + a.height) := by
      rintro _ ⟨p, hp, rfl⟩
      change p.column ≤ a.column + a.height
      by_contra! hlarge
      have hnot : a ≠ p := fun heq => hlarge.not_ge (by subst p; simp)
      have hh : a.height ≤ p.height := hamin.symm ▸ Nat.find_min' hex ⟨p, hp, rfl⟩
      exact hA ha hp hnot ⟨hh, Or.inr hlarge⟩
    apply ((finite_Iic _).subset hcols).of_finite_image
    intro x hx y hy heq
    by_contra hne
    rcases le_total x.height y.height with hxy | hyx
    · exact hA hx hy hne ⟨hxy, Or.inl heq⟩
    · exact hA hy hx (fun h => hne h.symm) ⟨hyx, Or.inl heq.symm⟩
  · exact (Set.not_nonempty_iff_eq_empty.1 hne).symm ▸ finite_empty

def column (n : ℕ) : Set Point := {p | p.column = n}

def columnRay (n : ℕ) : IncreasingChain Point := by
  let C : Set Point := column n
  have hsat : IsSaturatedChain C := by
    apply IsSaturatedChain.of_ordConnected
    · intro a ha b hb _
      have hab : a.column = b.column := ha.trans hb.symm
      exact (le_total a.height b.height).imp (fun h => ⟨h, Or.inl hab⟩) (fun h => ⟨h, Or.inl hab.symm⟩)
    · constructor
      intro a ha b hb p hab
      change a.column = n at ha
      change b.column = n at hb
      change p.column = n
      exact le_antisymm ((column_mono hab.2).trans_eq hb) (ha.symm.trans_le (column_mono hab.1))
  let A : SaturatedChain Point := ⟨C, ⟨⟨n, 0⟩, rfl⟩, hsat⟩
  refine ⟨A, ?_⟩
  rintro ⟨p, hp⟩
  let q : A := ⟨⟨p.1.column, p.1.height + 1⟩, p.2⟩
  exact (Nat.not_succ_le_self p.1.height) ((le_iff.1 (hp q)).1)

theorem columnRay_omega (n : ℕ) : IsOmegaRepresentative (columnRay n) := by
  intro a
  have hinj : Function.Injective (fun p : (columnRay n).1 => p.1.height) := by
    intro p q h
    exact Subtype.ext (Point.eq_of_coordinates (p.2.trans q.2.symm) h)
  exact ((finite_Iic a.1.height).preimage hinj.injOn).subset (fun _ h => (le_iff.1 h).1)

def columnGerm (n : ℕ) : IncreasingGerm Point := IncreasingGerm.ofChain (columnRay n)

theorem columnGerm_atomic (n : ℕ) : IsAtomicIncreasing (columnGerm n) :=
  ⟨columnRay n, rfl, (columnRay_omega n).no_omegaSucc⟩

private theorem columnGerm_not_cofinalAbove {n m : ℕ} (hne : n ≠ m) :
    ¬ IncreasingGerm.CofinalAbove (columnGerm n) (columnGerm m) := by
  intro h
  obtain ⟨p, hp⟩ := (IncreasingGerm.cofinalAbove_ofChain_iff (columnRay n) (columnRay m)).1 h
    ⟨⟨m, n⟩, rfl⟩
  have hc : p.1.column = n := p.2
  rcases hp.le.2 with heq | hlt
  · exact hne (heq.trans hc).symm
  · change m + n < p.1.column at hlt
    omega

theorem columnGerm_incomparable {n m : ℕ} (hne : n ≠ m) :
    ¬ IncreasingGerm.CofinalAbove (columnGerm n) (columnGerm m) ∧
    ¬ IncreasingGerm.CofinalAbove (columnGerm m) (columnGerm n) :=
  ⟨columnGerm_not_cofinalAbove hne, columnGerm_not_cofinalAbove hne.symm⟩

theorem columnGerm_injective : Function.Injective columnGerm := by
  intro n m h
  by_contra hne
  exact columnGerm_not_cofinalAbove hne (h ▸ IncreasingGerm.cofinalAbove_refl (columnGerm n))

theorem columnGerm_consolidation_minimal (n : ℕ) {g : IncreasingGerm Point}
    (h : IncreasingGerm.CofinalAbove (columnGerm n) g) : g = columnGerm n := by
  classical
  obtain ⟨A, hAg⟩ := IncreasingGerm.exists_representative g
  have hcolumns (a : A.1) : a.1.column ≤ n := by
    have hsub := h (show a.1 ∈ g.lowerProfile from hAg ▸ IncreasingGerm.representative_mem_lowerProfile A a)
    obtain ⟨p, hap⟩ := (IncreasingGerm.mem_lowerProfile_ofChain (columnRay n) a.1).1 hsub
    exact (column_mono hap.le).trans_eq p.2
  have hfin : (Point.column '' A.1.carrier).Finite := by
    apply (finite_Iic n).subset
    rintro _ ⟨p, hp, rfl⟩
    exact hcolumns ⟨p, hp⟩
  obtain ⟨m, ⟨a, ha, rfl⟩, hmax⟩ := hfin.exists_maximal (A.1.nonempty.image Point.column)
  let a' : A.1 := ⟨a, ha⟩
  let B : IncreasingChain Point := ⟨A.1.tail a', A.1.tail_noTop a' A.2⟩
  have hB := PositiveSweep.tail_represents hAg a'
  have hBcol (p : B.1) : p.1.column = a.column := by
    have hp : p.1.column ∈ Point.column '' A.1.carrier := ⟨p.1, p.2.1, rfl⟩
    have hle := column_mono p.2.2
    exact (hmax hp hle).antisymm hle
  have homega : IsOmegaRepresentative B := by
    intro p
    have hinj : Function.Injective (fun q : B.1 => q.1.height) := by
      intro q r h
      exact Subtype.ext (Point.eq_of_coordinates ((hBcol q).trans (hBcol r).symm) h)
    exact ((finite_Iic p.1.height).preimage hinj.injOn).subset (fun _ h => (le_iff.1 h).1)
  have hbelow := IncreasingGerm.cofinalAbove_ofChain_iff (columnRay a.column) B
  have habove := IncreasingGerm.cofinalAbove_ofChain_iff B (columnRay a.column)
  have h₁ : IncreasingGerm.CofinalAbove (columnGerm a.column) (IncreasingGerm.ofChain B) := by
    apply hbelow.2
    intro p
    refine ⟨⟨⟨a.column, p.1.height + 1⟩, rfl⟩, lt_of_le_of_ne ⟨Nat.le_succ _, Or.inl (hBcol p)⟩ ?_⟩
    exact fun heq => Nat.succ_ne_self _ (congrArg Point.height heq).symm
  have h₂ : IncreasingGerm.CofinalAbove (IncreasingGerm.ofChain B) (columnGerm a.column) := by
    apply habove.2
    intro p
    have hex : ∃ q : B.1, p.1.height < q.1.height := by
      by_contra! hmaxB
      have hf : (B.1.carrier).Finite := by
        have himg : (Point.height '' B.1.carrier).Finite :=
          (finite_Iic _).subset (by rintro _ ⟨x, hx, rfl⟩; exact hmaxB ⟨x, hx⟩)
        exact himg.of_finite_image (fun x hx y hy heq =>
          Point.eq_of_coordinates ((hBcol ⟨x, hx⟩).trans (hBcol ⟨y, hy⟩).symm) heq)
      exact increasingChain_infinite B hf
    obtain ⟨q, hq⟩ := hex
    exact ⟨q, lt_of_le_of_ne ⟨hq.le, Or.inl (p.2.trans (hBcol q).symm)⟩
      (fun h => hq.ne (congrArg Point.height h))⟩
  have heq : IncreasingGerm.ofChain B = columnGerm a.column :=
    positiveAtom_eq_of_lowerProfile_eq ⟨B, rfl, homega⟩ ⟨columnRay a.column, rfl, columnRay_omega _⟩
      (Set.Subset.antisymm h₁ h₂)
  have hga : g = columnGerm a.column := hB.symm.trans heq
  by_cases heq : n = a.column
  · simpa only [heq] using hga
  · exact (columnGerm_not_cofinalAbove heq (hga ▸ h)).elim

/-- The paper's FAC counterexample has infinitely many pairwise consolidation-incomparable
minimal positive atoms, indexed by the columns. -/
theorem has_infinite_minimal_atom_antichain :
    IsFAC Point ∧ (range columnGerm).Infinite ∧
      (∀ g ∈ range columnGerm, IsAtomicIncreasing g ∧
        ∀ h, IncreasingGerm.CofinalAbove g h → h = g) ∧
      IsAntichain IncreasingGerm.CofinalAbove (range columnGerm) := by
  refine ⟨isFAC, Set.infinite_range_of_injective columnGerm_injective, ?_, ?_⟩
  · rintro g ⟨n, rfl⟩
    exact ⟨columnGerm_atomic n, fun _ => columnGerm_consolidation_minimal n⟩
  · rintro _ ⟨n, rfl⟩ _ ⟨m, rfl⟩ hne
    exact columnGerm_not_cofinalAbove (fun h => hne (congrArg columnGerm h))

end AharoniKorman.Consolidation.ColumnCounterexample
